{
  // ===========================
  // Python Linting & Formatting
  // ===========================
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/venv/Lib/site-packages"],
  "python.venvPath": "${workspaceFolder}",
  "python.venvFolders": ["${workspaceFolder}"],
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.stubPath": "${workspaceFolder}/venv/Lib/site-packages",
  "python.linting.enabled": true,
  "python.linting.lintOnSave": true,
  "python.linting.flake8Enabled": true,
  "python.linting.flake8Args": ["--config=.flake8"],
  "python.linting.pylintEnabled": false,
  "python.linting.mypyEnabled": false,
  "python.formatting.provider": "black",
  "isort.args": ["--settings-path=pyproject.toml"],
  "isort.check": true,

  // ===========================
  // Pyright Configuration
  // ===========================
  "pyright.useLibraryCodeForTypes": true,
  "pyright.include": ["core", "economic_overview", "market_overview", "data_visualization"],
  "pyright.exclude": ["**/migrations", "**/staticfiles", "**/__pycache__", "**/node_modules"],
  "pyright.reportMissingTypeStubs": false,
  "pyright.reportMissingImports": true,
  "pyright.reportIncompatibleVariableOverride": false,
  "pyright.reportInvalidTypeForm": false,
  "pyright.pythonVersion": "3.12",
  "pyright.venvPath": "${workspaceFolder}",
  "pyright.venv": "venv",

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // ===========================
  // JavaScript Linting & Formatting
  // ===========================
  "eslint.enable": true,
  "eslint.run": "onSave",
  "eslint.validate": ["javascript"],
  "eslint.options": {
    "configFile": ".eslintrc.json"
  },
  "eslint.lintTask.enable": true,
  "eslint.codeActionsOnSave.mode": "all",

  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },

  // ===========================
  // CSS Linting & Formatting
  // ===========================
  "stylelint.enable": true,
  "stylelint.validate": ["css"],
  "stylelint.snippet": ["css"],
  "css.validate": false,

  "[css]": {
    "editor.defaultFormatter": "stylelint.vscode-stylelint",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.stylelint": "explicit"
    }
  },

  // ===========================
  // HTML Validation
  // ===========================
  "htmlhint.enable": true,
  "htmlhint.options": {
    "configFile": ".htmlhintrc"
  },

  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },

  // ===========================
  // JSON Formatting
  // ===========================
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // ===========================
  // Django Templates
  // ===========================
  "[django-html]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },

  // ===========================
  // General Editor Settings
  // ===========================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": null,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "files.eol": "\r\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ===========================
  // Problems Panel
  // ===========================
  "problems.showCurrentInStatus": true,

  // Disable format on save for markdown files
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": null
  }
}
